<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingEnd="16dp">

    <View
        android:id="@+id/view_line_top"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="?attr/colorPrimary"
        android:alpha="0.5"
        app:layout_constraintBottom_toTopOf="@id/view_node"
        app:layout_constraintEnd_toEndOf="@id/view_node"
        app:layout_constraintStart_toStartOf="@id/view_node"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_node"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="24dp"
        android:background="@drawable/vcode_git_node_outline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <View
        android:id="@+id/view_line_bottom"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="?attr/colorPrimary"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/view_node"
        app:layout_constraintStart_toStartOf="@id/view_node"
        app:layout_constraintTop_toBottomOf="@id/view_node" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_overflow"
        app:layout_constraintStart_toEndOf="@id/view_node"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_head_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/vcode_bg_symbol_key"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="HEAD"
                android:textAllCaps="true"
                android:textColor="@color/vcode_on_secondary_container"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textSize="10sp"
                app:backgroundTint="@color/vcode_secondary_container"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_sha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                tools:text="7f3a2b1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            tools:text="feat: implement dark mode git history viewer" />

        <TextView
            android:id="@+id/tv_author_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="@color/vcode_text_secondary"
            tools:text="Alex Rivera • 2 hours ago" />

    </LinearLayout>

    <ImageView
        android:id="@+id/btn_overflow"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="5dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_ellipsis_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vcode_text_secondary" />

</androidx.constraintlayout.widget.ConstraintLayout>