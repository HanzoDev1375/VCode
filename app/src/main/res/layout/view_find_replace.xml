<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vcode_bg_toolbar"
    android:elevation="4dp"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="sans-serif"
            android:hint="Find..."
            android:imeOptions="actionNext"
            android:inputType="textNoSuggestions"
            android:textColor="@color/vcode_text_primary"
            android:textColorHint="@color/vcode_text_hint"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_match_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/vcode_text_secondary"
            android:textSize="12sp"
            tools:text="1/5" />

        <ImageView
            android:id="@+id/btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/vcode_text_secondary" />

        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/vcode_text_secondary" />

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_xmark"
            app:tint="@color/vcode_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_replace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="sans-serif"
            android:hint="Replace with..."
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions"
            android:textColor="@color/vcode_text_primary"
            android:textColorHint="@color/vcode_text_hint"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_replace"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Replace"
            android:textColor="@color/vcode_accent_primary"
            android:textSize="12sp"
            app:cornerRadius="@dimen/vcode_button_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_replace_all"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="All"
            android:textColor="@color/vcode_accent_primary"
            android:textSize="12sp"
            app:cornerRadius="@dimen/vcode_button_corner_radius" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_case"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Aa"
            android:textAllCaps="false"
            android:textColor="@color/vcode_text_secondary"
            android:textSize="12sp"
            app:cornerRadius="4dp"
            app:strokeColor="@color/vcode_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_word"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="W"
            android:textAllCaps="false"
            android:textColor="@color/vcode_text_secondary"
            android:textSize="12sp"
            app:cornerRadius="4dp"
            app:strokeColor="@color/vcode_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_regex"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text=".*"
            android:textAllCaps="false"
            android:textColor="@color/vcode_text_secondary"
            android:textSize="12sp"
            app:cornerRadius="4dp"
            app:strokeColor="@color/vcode_divider" />
    </LinearLayout>

</LinearLayout>