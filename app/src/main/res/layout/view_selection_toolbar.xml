<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/selectionToolbarRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vcode_bg_toolbar"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="4dp"
    android:paddingEnd="8dp"
    android:paddingStart="8dp"
    android:paddingTop="4dp">

    <!-- Cancel on the left -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:text="@string/vcode_action_cancel"
        android:textColor="@color/vcode_text_secondary"
        android:textSize="13sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Cut -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCut"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:drawablePadding="4dp"
        android:minWidth="0dp"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:text="@string/vcode_action_cut"
        android:textColor="@color/vcode_text_primary"
        android:textSize="13sp"
        app:icon="@drawable/ic_scissors"
        app:iconGravity="start"
        app:iconPadding="4dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- Copy -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopy"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:text="@string/vcode_action_copy"
        android:textColor="@color/vcode_text_primary"
        android:textSize="13sp"
        app:icon="@drawable/ic_copy"
        app:iconGravity="start"
        app:iconPadding="4dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- Paste -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPaste"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:text="@string/vcode_action_paste"
        android:textColor="@color/vcode_text_primary"
        android:textSize="13sp" />

    <!-- Select All -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectAll"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:text="@string/vcode_action_select_all"
        android:textColor="@color/vcode_text_primary"
        android:textSize="13sp" />

</LinearLayout>
