<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/vcode_bg_surface"
    app:strokeColor="@color/vcode_divider"
    app:strokeWidth="1dp">

    <HorizontalScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/selectionToolbarRoot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp"
            android:paddingEnd="8dp"
            android:paddingStart="8dp"
            android:paddingTop="4dp">

            <!-- Cut -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCut"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingEnd="12dp"
                android:paddingStart="12dp"
                android:text="@string/vcode_action_cut"
                android:textColor="@color/vcode_text_primary"
                android:textSize="14sp" />

            <!-- Copy -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopy"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingEnd="12dp"
                android:paddingStart="12dp"
                android:text="@string/vcode_action_copy"
                android:textColor="@color/vcode_text_primary"
                android:textSize="14sp" />

            <!-- Paste -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPaste"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingEnd="12dp"
                android:paddingStart="12dp"
                android:text="@string/vcode_action_paste"
                android:textColor="@color/vcode_text_primary"
                android:textSize="14sp" />

            <!-- Select All -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAll"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingEnd="12dp"
                android:paddingStart="12dp"
                android:text="@string/vcode_action_select_all"
                android:textColor="@color/vcode_text_primary"
                android:textSize="14sp" />

        </LinearLayout>
    </HorizontalScrollView>
</com.google.android.material.card.MaterialCardView>
