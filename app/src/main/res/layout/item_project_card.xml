<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:gravity="center"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/vcode_app_gap_horizontal"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_action_rename"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pen"
            app:tint="?attr/colorOnPrimary" />

        <ImageView
            android:id="@+id/btn_action_delete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_trash"
            app:tint="?attr/colorOnPrimary" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/project_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vcode_app_gap_horizontal"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="@dimen/vcode_card_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/vcode_app_gap_horizontal"
            android:paddingEnd="0dp">

            <LinearLayout
                android:id="@+id/badges_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/vcode_app_gap_horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_project_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/badges_container"
                tools:text="VCode" />

            <TextView
                android:id="@+id/tv_project_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vcode_app_gap_horizontal"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_project_name"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="42 files · last modified 2h ago" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>