<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"/>

    <LinearLayout
        android:id="@+id/layout_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_clone_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clone Repository"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:layout_marginStart="@dimen/vcode_app_gap_horizontal"
            android:layout_marginEnd="@dimen/vcode_app_gap_horizontal"/>

        <TextView
            android:id="@+id/tv_clone_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter a remote Git repository URL to clone it into your active local workspace."
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="@dimen/vcode_app_gap_horizontal"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_repo_url_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REPOSITORY URL"
                    android:layout_marginTop="24dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:labelFor="@id/et_repo_url"
                    android:layout_marginStart="@dimen/vcode_app_gap_horizontal"/>

                <EditText
                    android:id="@+id/et_repo_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/vcode_app_gap_horizontal"
                    android:layout_marginTop="6dp"
                    android:background="?attr/colorSurfaceContainerHigh"
                    android:hint="https://github.com/username/repo.git"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:padding="14dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"/>

                <TextView
                    android:id="@+id/tv_project_name_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROJECT DISPLAY NAME"
                    android:layout_marginTop="20dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:labelFor="@id/et_project_name"
                    android:layout_marginStart="@dimen/vcode_app_gap_horizontal"/>

                <EditText
                    android:id="@+id/et_project_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/vcode_app_gap_horizontal"
                    android:layout_marginTop="6dp"
                    android:background="?attr/colorSurfaceContainerHigh"
                    android:hint="My Cloned App"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:padding="14dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_execute_clone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="@dimen/vcode_app_gap_horizontal"
                    android:layout_marginBottom="20dp"
                    android:paddingHorizontal="24dp"
                    android:text="Clone Workspace"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorOnPrimary"
                    app:backgroundTint="?attr/colorPrimary"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_progress"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorSize="64dp"
                app:indicatorColor="?attr/colorPrimary"/>

            <TextView
                android:id="@+id/tv_progress_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0%"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorPrimary"/>
        </FrameLayout>

        <TextView
            android:id="@+id/tv_progress_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Initializing remote workspace..."
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"/>

        <TextView
            android:id="@+id/tv_progress_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Resolving delta objects..."
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"/>
            
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_run_background"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Run in Background"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

</LinearLayout>