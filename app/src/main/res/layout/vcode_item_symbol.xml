<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/vcode_img_symbol_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_file_lines"
        android:contentDescription="Symbol Icon"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/vcode_txt_symbol_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/vcode_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vcode_txt_symbol_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/vcode_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/vcode_txt_symbol_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/vcode_text_hint"
        android:textSize="12sp" />

</LinearLayout>
