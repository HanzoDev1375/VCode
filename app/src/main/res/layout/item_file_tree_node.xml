<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vcode_file_tree_item_height"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="16dp">

    <Space
        android:id="@+id/indent_spacer"
        android:layout_width="0dp"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/iv_chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/vcode_text_secondary"
        tools:ignore="UseAppTint" />

    <TextView
        android:id="@+id/tv_lang_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/vcode_bg_symbol_key"
        android:fontFamily="sans-serif-black"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:textColor="@color/vcode_accent_primary"
        android:textSize="8sp"
        android:visibility="gone"
        tools:ignore="SmallSp"
        tools:text="HTML"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_folder"
        android:tint="@color/vcode_accent_warning"
        android:visibility="gone"
        tools:ignore="UseAppTint" />

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:textColor="@color/vcode_text_primary"
        android:textSize="13sp"
        tools:text="index.html" />

    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_add_file"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ic_file_plus"
            android:tint="@color/vcode_text_secondary"
            tools:ignore="UseAppTint" />

        <ImageView
            android:id="@+id/btn_add_folder"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ic_folder_plus"
            android:tint="@color/vcode_text_secondary"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <com.cocode.vcode.ide.views.GitStatusBadge
        android:id="@+id/git_status_badge"
        android:layout_width="@dimen/vcode_git_status_icon_size"
        android:layout_height="@dimen/vcode_git_status_icon_size"
        android:layout_marginStart="8dp" />

</LinearLayout>